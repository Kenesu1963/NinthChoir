  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  interactRadius: 1.5
  prompt: Talk
  npcName: Villager
  shop: {fileID: 0}
  openShopDirectly: 1
  nodes:
  - id: start
    speaker: 
    text: Hola, que te trae por aqui?
    choices:
    - text: Solo estoy mirando
      goTo: looking
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: Algun consejo?
      goTo: advice
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: Adios!!
      goTo: 
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    next: 
  - id: looking
    speaker: 
    text: Tomate tu tiempo, las ruinas al este tienen algo interesante
    choices: []
    next: 
  - id: advice
    speaker: 
    text: Sigue moviendote, y no temas de dashear a los enemigos.
    choices: []
    next: start
