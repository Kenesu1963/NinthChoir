  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 50903465}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21807bb349425842f8377bb05ddd93da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  interactRadius: 1.5
  prompt: Talk
  npcName: John
  nodes:
  - id: start
    speaker: 
    text: "Felicidades!!!!, legaste a la cima de la monta\xF1a!!"
    choices:
    - text: y el tesoro?
      goTo: looking
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: Gracias...
      goTo: advice
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: Adios
      goTo: 
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    next: 
  - id: looking
    speaker: 
    text: Lo tengo yo, lo quieres por 10 monedas?
    choices:
    - text: SI!!!!
      goTo: RespuestaSi
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: no...
      goTo: RespuestaNo
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    next: 
  - id: advice
    speaker: 
    text: de nada, ojala hubieras visto el tesoro que estaba aqui.
    choices: []
    next: 
  - id: RespuestaSi
    speaker: 
    text: Lo siento, aun no han agregado el sistema de ventas :P
    choices: []
    next: 
  - id: RespuestaNo
    speaker: 
    text: bueno, ya puedes bajar
    choices: []
    next: 
