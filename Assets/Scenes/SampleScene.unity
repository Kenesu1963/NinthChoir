  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Shop
  shopName: Juans Shop
  portrait: {fileID: 0}
  greeting: Un placer!
  menuLine: Algo mas?
  buyLine: Que te gusta de aqui?
  tradeLine: fue un placer.
  talkLine: "Desde hace a\xF1os vivo aqui, de joven queria salir en aventuras como
    tu!."
  thanksLine: vuelve pronto.
  stock:
  - item: {fileID: 11400000, guid: 489c955ee769a9750a1294b76451a5a9, type: 2}
    price: 1
    stock: -1
  - item: {fileID: 11400000, guid: 968c3adf6de765358ba51778dc508bca, type: 2}
    price: 2
    stock: -1
  - item: {fileID: 11400000, guid: 5c1dc3c60174090fb8efcc6b34f2f860, type: 2}
    price: 4
    stock: 2
  trades: []
  topics:
  - topic: Quien eres?
    reply: Un campesino modesto, quiero vivir tranquilo en estas tierras.
  - topic: Algun rumor?
    reply: "Escuche que hay 3 tesoros en este campo, uno protegido por demonios,
      otro en las ruinas antiguas y otro en la monta\xF1a."
  - topic: Como me voy de aqui
    reply: Hay rumores de una salida misteriosa en la cueva debajo de las ruinas
      al este.
